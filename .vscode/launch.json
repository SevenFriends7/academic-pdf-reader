{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行扩展 (Run Extension)",
      "type": "extensionDevelopmentHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "npm: compile"
    }
  ]
}
