# 发布打包排除清单
#
# vsce / vsce publish 按本文件过滤内容。语义与 .gitignore 相同：
#   ** 后面的规则可以覆盖前面的规则（这与 .gitignore 一致）。
#
# 截图策略（重要）：
#   - README 里的预览图必须用绝对 HTTPS 地址（fastly jsDelivr）：VS Code 扩展详情页
#     的 sanitizer 默认禁止相对图片路径（allowRelativeMediaPaths=false），webview 的
#     CSP 也只允许 img-src https: / data:。即使截图在扩展目录里也不会显示。
#   - 市场包（vsce）：下面排除 media/screenshots/**，控制体积；图片由 README 的绝对
#     URL 从 CDN 加载。
#   - 本机包（package-vsix.js）：不走本文件，仍会复制整个 media（含 screenshots），
#     但详情页实际还是走 README 里的绝对 URL。
#   - package.json 的 vsix / publish:* 与 CI 保留
#       --baseImagesUrl https://fastly.jsdelivr.net/gh/SevenFriends7/academic-pdf-reader@main/
#       --baseContentUrl https://github.com/SevenFriends7/academic-pdf-reader/blob/main/
#     作为兜底：以后若 README 又出现相对图片/链接，商店包会被改写成绝对地址；
#     本机包不受这个兜底保护，改回相对路径会再次破图。
#
# 注意：本地打包脚本 package-vsix.js 用的是自己的白名单（只复制
# package.json / README / CHANGELOG / LICENSE / 第三方声明 / dist / media / py），
# 它本来就会把 media 整个复制进包，与本文件的排除规则无关。

# ---- 开发与测试资料 ----
scratch/**
output_test/**
docs/**
.github/**
.vscode/**
node_modules/**
src/**
test-papers/**
dist-test/**
mineru_out_test/**
py/__pycache__/**
*.pyc
out_vision.json
esbuild.js
esbuild-wasm.js
package-vsix.js
package-all.js
package-lock.json
tsconfig.json
.eslintrc.json
.gitignore
.gitattributes
.vscodeignore

# ---- 本地产物与备份 ----
*.vsix
*.log
*.tmp
*.bak*
*.orig

# ---- 源码映射（体积大且会暴露源码）----
dist/*.map
media/*.map

# ---- 商店展示截图：市场包走 CDN，本机包由 package-vsix.js 单独复制 ----
media/screenshots/**

# ---- 密钥与个人数据（万一误放于仓库根目录）----
*.key
.gemini-key
.env
.env.*
paper_*.json
